<?xml version="1.0" encoding="utf-8"?>
<!-- تطبيق معهد عبد الله بن حذافة: غلاف أصلي (WebView) يفتح المنصة الحية https://ibh.nafahatsy.com (المرحلة ب) -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- الحفظ في «التنزيلات» على أندرويد 7–9 فقط؛ من أندرويد 10 يُحفظ عبر MediaStore بلا إذن -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
    <!-- هاتف الجرس: إبقاء المعالج يقظاً ما دام الجرس يعمل، ومنبّه دقيق للرنّة التالية (setAlarmClock).
         USE_EXACT_ALARM يُمنح تلقائياً من أندرويد 13؛ وفي 12–12L يكفي SCHEDULE_EXACT_ALARM (ممنوح افتراضاً هناك) -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- تنبيهات الدوام (1.2.0): الإشعار نفسه (أندرويد 13+ يُطلب بشرح مرة واحدة)، وإعادة المنبّهات بعد إعادة تشغيل الهاتف -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 1.3.1: خدمة أمامية قصيرة (shortService، بلا إذن نوع خاص) تشغّل نغمة التنبيه والجرس والتطبيق في الخلفية -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/AppTheme.Launch"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity>

        <!-- وضع «هاتف الجرس»: يقرأ جرس فرع واحد برمز الجرس (Authorization: Bell) ويرنّ والشاشة مضاءة -->
        <activity
            android:name=".BellActivity"
            android:exported="false"
            android:label="@string/bell_title"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation"
            android:windowSoftInputMode="adjustResize" />

        <!-- المنبّه الدقيق لهاتف الجرس (BellPlan.kt): غير مُصدَّر -->
        <receiver android:name=".BellAlarmReceiver" android:exported="false" />

        <!-- أداة الإدارة على الشاشة الرئيسية (AdminWidget.kt). مُصدَّرة لأن النظام يرسل إليها APPWIDGET_UPDATE،
             ومحمية بـ BIND_APPWIDGET (لا يرسل إليها إلا النظام)؛ ولا تطلب الشبكة أكثر من مرة في الدقيقة مهما أُرسل إليها. لا إذن جديد -->
        <receiver
            android:name=".AdminWidget"
            android:exported="true"
            android:permission="android.permission.BIND_APPWIDGET"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/admin_widget_info" />
        </receiver>

        <!-- إعدادات «تنبيهات الدوام» (Rings.kt): من الاختصار عبر MainActivity أو من المنصة -->
        <activity
            android:name=".AlertsActivity"
            android:exported="false"
            android:label="@string/al_title"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation" />

        <!-- تشغيل النغمة من المنبّه (ToneService.kt): غير مُصدَّرة، تتوقف بعد النغمة وبمهلة قصوى 60 ثانية -->
        <service
            android:name=".ToneService"
            android:exported="false"
            android:foregroundServiceType="shortService" />

        <!-- منبّه التنبيه التالي والجلب اليومي لتنبيهات الدوام: غير مُصدَّر، ورموز طلبه غير رموز هاتف الجرس -->
        <receiver android:name=".RingAlarmReceiver" android:exported="false" />

        <!-- إعادة التشغيل وتحديث التطبيق وتغيير الوقت/المنطقة: تُعاد منبّهات الدوام وهاتف الجرس. مُصدَّر لأن النظام يرسلها -->
        <receiver android:name=".SystemEventsReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- ضغطة «حدّث» في رأس الأداة: غير مُصدَّر -->
        <receiver android:name=".WidgetRefreshReceiver" android:exported="false" />

        <!-- مزوّد خاص لصورة الكاميرا (بديل FileProvider بلا مكتبات): غير مُصدَّر، ويمنح الكتابة لتطبيق الكاميرا مؤقتاً -->
        <provider
            android:name=".CaptureProvider"
            android:authorities="com.nafahatsy.ibh.capture"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
